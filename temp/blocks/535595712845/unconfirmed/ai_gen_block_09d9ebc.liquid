{% doc %}
  @prompt
    Create a color schemes feature that allows switching between multiple preset color palettes. Each scheme should define a set of coordinated colors (background, foreground, accent colors) that can be applied globally to the storefront. Include a settings panel where the merchant can select from named color schemes like "Default", "Dark", "Warm", "Cool", etc., and customize each scheme's colors individually.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-color-schemes-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 16px;
    color: {{ block.settings.default_foreground }};
    background: {{ block.settings.default_background }};
    border: 1px solid {{ block.settings.default_accent }};
    border-radius: 12px;
  }

  .ai-color-schemes-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ai-color-schemes-{{ ai_gen_id }}__label {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-color-schemes-{{ ai_gen_id }}__select {
    min-height: 44px;
    min-width: 180px;
    padding: 8px 36px 8px 12px;
    color: inherit;
    background-color: transparent;
    border: 1px solid currentColor;
    border-radius: 6px;
    font: inherit;
  }

  .ai-color-schemes-{{ ai_gen_id }}__select:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ai-color-schemes-{{ ai_gen_id }}__swatches {
    display: flex;
    gap: 6px;
  }

  .ai-color-schemes-{{ ai_gen_id }}__swatch {
    width: 22px;
    height: 22px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  @media screen and (max-width: 749px) {
    .ai-color-schemes-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<color-scheme-switcher-{{ ai_gen_id }}
  class="ai-color-schemes-{{ ai_gen_id }}"
  data-default-bg="{{ block.settings.default_background }}"
  data-default-fg="{{ block.settings.default_foreground }}"
  data-default-accent="{{ block.settings.default_accent }}"
  data-default-muted="{{ block.settings.default_secondary }}"
  data-dark-bg="{{ block.settings.dark_background }}"
  data-dark-fg="{{ block.settings.dark_foreground }}"
  data-dark-accent="{{ block.settings.dark_accent }}"
  data-dark-muted="{{ block.settings.dark_secondary }}"
  data-warm-bg="{{ block.settings.warm_background }}"
  data-warm-fg="{{ block.settings.warm_foreground }}"
  data-warm-accent="{{ block.settings.warm_accent }}"
  data-warm-muted="{{ block.settings.warm_secondary }}"
  data-cool-bg="{{ block.settings.cool_background }}"
  data-cool-fg="{{ block.settings.cool_foreground }}"
  data-cool-accent="{{ block.settings.cool_accent }}"
  data-cool-muted="{{ block.settings.cool_secondary }}"
  data-persist="{{ block.settings.remember_selection }}"
  data-block-id="{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-color-schemes-{{ ai_gen_id }}__inner">
    <label class="ai-color-schemes-{{ ai_gen_id }}__label" for="ai-color-scheme-select-{{ ai_gen_id }}">{{ block.settings.label }}</label>
    <select id="ai-color-scheme-select-{{ ai_gen_id }}" class="ai-color-schemes-{{ ai_gen_id }}__select" aria-label="{{ block.settings.label | escape }}">
      <option value="default">Default</option>
      <option value="dark">Dark</option>
      <option value="warm">Warm</option>
      <option value="cool">Cool</option>
    </select>
    <div class="ai-color-schemes-{{ ai_gen_id }}__swatches" aria-hidden="true">
      <span class="ai-color-schemes-{{ ai_gen_id }}__swatch" style="background: {{ block.settings.default_background }}"></span>
      <span class="ai-color-schemes-{{ ai_gen_id }}__swatch" style="background: {{ block.settings.default_accent }}"></span>
      <span class="ai-color-schemes-{{ ai_gen_id }}__swatch" style="background: {{ block.settings.default_secondary }}"></span>
    </div>
  </div>
</color-scheme-switcher-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'color-scheme-switcher-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class ColorSchemeSwitcher extends HTMLElement {
      connectedCallback() {
        this.select = this.querySelector('select');
        if (!this.select) return;
        this.storageKey = `store-color-scheme-${this.dataset.blockId}`;
        this.select.addEventListener('change', () => this.applyScheme(this.select.value, true));
        let selected = 'default';
        if (this.dataset.persist === 'true') {
          try {
            selected = localStorage.getItem(this.storageKey) || 'default';
          } catch (error) {
            selected = 'default';
          }
        }
        if (!this.querySelector(`option[value="${selected}"]`)) selected = 'default';
        this.select.value = selected;
        this.applyScheme(selected, false);
      }

      applyScheme(scheme, save) {
        const root = document.documentElement;
        const background = this.dataset[`${scheme}Bg`];
        const foreground = this.dataset[`${scheme}Fg`];
        const accent = this.dataset[`${scheme}Accent`];
        const secondary = this.dataset[`${scheme}Muted`];
        root.style.setProperty('--color-background', background);
        root.style.setProperty('--color-foreground', foreground);
        root.style.setProperty('--color-accent', accent);
        root.style.setProperty('--color-secondary-accent', secondary);
        root.style.setProperty('--ai-store-background', background);
        root.style.setProperty('--ai-store-foreground', foreground);
        root.style.setProperty('--ai-store-accent', accent);
        root.style.setProperty('--ai-store-secondary-accent', secondary);
        root.dataset.aiColorScheme = scheme;
        if (save && this.dataset.persist === 'true') {
          try {
            localStorage.setItem(this.storageKey, scheme);
          } catch (error) {}
        }
      }
    }

    customElements.define(tagName, ColorSchemeSwitcher);
  })();
</script>

